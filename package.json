{
  "name": "abay-grand-hotel",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "scripts": {
    "build": "npm --prefix admin run build && node -e \"const fs=require('fs'); if(fs.existsSync('admin/dist')) fs.cpSync('admin/dist', 'dist', {recursive:true});\"",
    "build:all": "npm --prefix frontend run build && npm --prefix admin run build",
    "build:admin": "npm --prefix admin run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "node --check backend/server.js",
    "start": "node backend/server.js",
    "db:diag": "node backend/scripts/db-diagnostics.js",
    "generate-favicons": "node scripts/generate-favicons-standalone.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.6.3",
    "react": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.17.0",
    "react-toastify": "^11.1.0",
    "tailwindcss": "^4.3.0",
    "toastify": "^2.0.1"
  }
}
